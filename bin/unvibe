#!/usr/bin/env sh
# Dev convenience wrapper: run the packaged `unvibe` CLI from a source checkout
# without installing it globally. Equivalent to `uv run unvibe ...`.
#
# For real installs, prefer:
#   uvx --from git+https://github.com/aaronfc/unvibe.git unvibe ...
#   uv tool install git+https://github.com/aaronfc/unvibe.git
here="$(cd "$(dirname "$0")/.." && pwd)"
exec uv run --quiet --project "$here" unvibe "$@"
